# Copy to .env and adjust as needed
APP_NAME=SQL Harness API
DEBUG=true
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5433/nl2sql

# Session cookie set by /api/auth/*
SESSION_COOKIE_NAME=sqlharness_session
SESSION_TTL_DAYS=30

#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CONNECTION_ENCRYPTION_KEY=

# Dev-only: lets "fire demo query" reach localhost/private-network databases.
# Leave false/unset anywhere this backend isn't fully trusted.
ALLOW_PRIVATE_CONNECTION_HOSTS=false

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=10
QDRANT_COLLECTION_NAME=schema_chunks
QDRANT_DENSE_VECTOR_SIZE=1536

MEM0_API_KEY=
